{
  "name": "agentgrid-website",
  "private": true,
  "version": "0.4.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file=server/.env server/index.mjs",
    "server:dev": "node --watch --env-file=server/.env server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test": "node --test",
    "verify": "npm run typecheck && npm test && npm run build",
    "backup": "node --env-file=server/.env scripts/backup-db.mjs",
    "start": "node --env-file=server/.env server/index.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.11.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^19.3.0",
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "@types/better-sqlite3": "^7.6.12"
  }
}
